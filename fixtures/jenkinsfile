pipeline {
    agent any

    tools {
        // Name must exactly match the NodeJS installer configured in 'Manage Jenkins > Tools'
        nodejs 'NodeJS' 
    }

    environment {
        // Setting up CI environment variable for Playwright headless mode optimization
        CI = 'true'
    }

    stages {
        stage('Checkout') {
            steps {
                // Pulls your code from the connected SCM (Git/GitHub)
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing Project Dependencies...'
                // Install npm packages (including typescript, playwright/test)
                sh 'npm ci'
            }
        }

        stage('Install Playwright Browsers') {
            steps {
                echo 'Installing Playwright System Dependencies and Browsers...'
                // Installs chromium, firefox, and webkit along with required OS libraries
                sh 'npx playwright install --with-deps'
            }
        }

        stage('Execute Playwright Tests') {
            steps {
                echo 'Executing Playwright TypeScript Tests...'
                // Executes tests. 'catchError' ensures subsequent stages run even if tests fail
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    sh 'npx playwright test'
                }
            }
        }
    }

    post {
        always {
            echo 'Archiving Test Artifacts...'
            // Archives the test results folder (HTML report screenshots/videos)
            archiveArtifacts artifacts: 'playwright-report/**', allowEmptyArchive: true
            
            // Optional: Publishes results to Jenkins UI if using 'junit' reporter
            // junit testResults: 'test-results/results.xml', allowEmptyResults: true
        }
    }
}